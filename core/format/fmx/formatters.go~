package fmx

import (
	"fmt"
	"github.com/andrerrcosta2/gtools/core/domain/execution"
	"runtime"
	"strings"
)

const (
	ansi = "\x1b]8;;%s\x1b\\%s:%d\x1b]8;;\x1b\\: %s"
)

func Call(s ...string) {
	_, file, line, ok := runtime.Caller(1)
	if !ok {
		fmt.Printf("⚠️ [?:?]: %s\n", strings.Join(s, ""))
		return
	}

	msg := strings.Join(s, "")
	displayFile := execution.GetFileDisplayPath(file, "")

	if execution.SupportsTerminalHyperlink {
		fullPath := "file://" + file
		fmt.Printf(ansi, fullPath, displayFile, line, msg)
	} else {
		fmt.Printf("%s:%d: %s\n", displayFile, line, msg)
	}
}

